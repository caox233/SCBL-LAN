<Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="ModFovSlider" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Margin="8,0">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource ModFovSliderDecreaseButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModFovSliderThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource ModFovSliderIncreaseButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
<Style x:Key="CinematicDialogAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
 <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="112"/><Setter Property="Height" Value="42"/><Setter Property="FontSize" Value="15"/>
</Style>
<Style x:Key="CinematicCheckBox" TargetType="CheckBox">
 <Setter Property="Foreground" Value="#B6BEC3"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
  <StackPanel Orientation="Horizontal"><Border Width="14" Height="14" BorderBrush="#88FFFFFF" BorderThickness="1" Background="#33000000" Margin="0,0,8,0"><Path x:Name="tick" Data="M 2,6 L 5,9 L 11,2" Stroke="{StaticResource ReadyAccentBrush}" StrokeThickness="1.5" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel>
  <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource ReadyAccentBrush}"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="HostSwitchButton" TargetType="Button">
 <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
 <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
 <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource ReadyAccentBrush}"/></Trigger></Style.Triggers>
</Style>
</Window.Resources>
 <!-- Presentation adapted from SCBL 3.0: full-bleed artwork, left launch surface, right sign-in. -->
 <Grid x:Name="rootGrid" ClipToBounds="True" PreviewGotKeyboardFocus="DialogBoundary_PreviewGotKeyboardFocus" PreviewKeyDown="DialogOverlay_PreviewKeyDown">
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
  <Image x:Name="backgroundImage" Grid.RowSpan="3" Source="Assets/background.png" Stretch="UniformToFill" IsHitTestVisible="False"/>
  <Border Grid.RowSpan="3" IsHitTestVisible="False"><Border.Background>
   <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="#28000000" Offset="0"/><GradientStop Color="#08000000" Offset="0.38"/>
    <GradientStop Color="#9C000000" Offset="0.66"/><GradientStop Color="#F0000000" Offset="1"/>
   </LinearGradientBrush>
  </Border.Background></Border>
  <Border Grid.RowSpan="3" IsHitTestVisible="False"><Border.Background>
   <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#10000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.45"/>
    <GradientStop Color="#B8000000" Offset="0.86"/><GradientStop Color="#F0000000" Offset="1"/>
   </LinearGradientBrush>
  </Border.Background></Border>
  <Border Grid.Row="0" Background="#25050709" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
   <Grid Margin="34,0,260,0">
    <TextBlock x:Name="txtAppTitle" Text="SCBL LAN" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <StackPanel x:Name="spTitleButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
   <Button x:Name="btnSettings" Content="设置" Width="60" Style="{StaticResource CinematicLinkButton}" Click="SettingsButton_Click"/>
   <Button x:Name="btnLanguageToggle" Content="中文 / EN" Width="78" Style="{StaticResource CinematicLinkButton}" Click="LanguageToggleButton_Click"/>
   <Button x:Name="btnMusicToggle" FontFamily="Segoe MDL2 Assets" Content="&#xE767;" ToolTip="背景音乐" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}" Style="{StaticResource WindowChromeButton}" Click="MusicToggleButton_Click"/>
   <Button x:Name="btnGuide" Content="?" ToolTip="使用指引" AutomationProperties.Name="使用指引" Style="{StaticResource WindowChromeButton}" Click="GuideButton_Click"/>
   <Border Width="1" Height="20" Background="#45FFFFFF" Margin="8,0"/>
   <Button x:Name="btnWindowMinimize" Content="−" ToolTip="最小化" Style="{StaticResource WindowChromeButton}" Click="WindowMinimizeButton_Click"/>
   <Button x:Name="btnWindowClose" Content="×" ToolTip="关闭" Style="{StaticResource WindowChromeCloseButton}" Click="WindowCloseButton_Click"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="76,12,42,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="376"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="heroPanel" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,32">
    <Border x:Name="bdStatusPanel" Background="Transparent" Margin="0,0,0,16">
     <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="serverStatusLight" Width="8" Height="8" Fill="#788289" Margin="0,0,9,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="txtConnectionStatusCaption" Visibility="Collapsed"/>
      <TextBlock x:Name="txtServerStatus" Text="未检测" FontSize="14" MaxWidth="350" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Grid Margin="0,0,0,18">
     <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="20"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock x:Name="txtConnectionModeLabel" Text="联机模式" FontSize="11" Foreground="#9CA8AD" Margin="0,0,0,5"/>
      <ListBox x:Name="cmbConnectionMode" Style="{StaticResource ModeListBox}" Width="124" Tag="112" SelectedIndex="0" SelectionChanged="ConnectionMode_SelectionChanged" AutomationProperties.Name="联机模式">
       <ListBoxItem x:Name="itemClientMode" Grid.Row="0" Content="加入房主"/>
       <ListBoxItem x:Name="itemHostMode" Grid.Row="1" Content="创建房主"/>
      </ListBox>
     </StackPanel>
     <Border Grid.Column="1" Width="1" Height="58" Background="#35FFFFFF" VerticalAlignment="Bottom"/>
     <StackPanel Grid.Column="2">
      <TextBlock x:Name="txtGameplayModeLabel" Text="游戏模式" FontSize="11" Foreground="#9CA8AD" Margin="0,0,0,5"/>
      <ListBox x:Name="cmbGameplayMode" Style="{StaticResource ModeListBox}" SelectedValue="MOD" SelectedValuePath="Tag" SelectionChanged="GameplayMode_SelectionChanged" AutomationProperties.Name="游戏模式" ToolTip="官方：不加载玩法插件；MOD：需要完整的本版 gameplay 模块。队友请使用相同游戏模式。">
       <ListBoxItem x:Name="itemGameplayMod" Grid.Row="0" Content="MOD" Tag="MOD"/><ListBoxItem x:Name="itemGameplayOfficial" Grid.Row="1" Content="官方" Tag="Official"/>
      </ListBox>
     </StackPanel>
    </Grid>
    <Grid x:Name="fovPanel" Width="344" Margin="0,0,0,14">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="txtFovLabel" Text="视野范围（FOV）" FontSize="11" Foreground="#A5ADB2"/>
     <TextBlock x:Name="txtFovValue" Grid.Column="1" Text="1.20×" FontSize="12" Foreground="{StaticResource ReadyAccentBrush}" Margin="0,0,14,0"/>
     <Button x:Name="btnFovReset" Grid.Column="2" Content="默认" Style="{StaticResource CinematicLinkButton}" FontSize="11" Click="FovReset_Click" ToolTip="默认 1.20×；1.00× 为原始视野"/>
     <Slider x:Name="fovSlider" Grid.Row="1" Grid.ColumnSpan="3" Minimum="1.0" Maximum="1.3" Value="1.2" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Style="{StaticResource ModFovSlider}" ValueChanged="FovSlider_ValueChanged" AutomationProperties.Name="FOV 视野倍率" ToolTip="1.00–1.30 倍，默认 1.20。官方与 MOD 均可使用，下次启动生效。"/>
    </Grid>
    <Button x:Name="btnLaunch" Content="启动游戏" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="LaunchButton_Click" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"/>
   </StackPanel>
   <Border x:Name="authPanel" Grid.Column="2" Background="#72080B0D" BorderBrush="#2EFFFFFF" BorderThickness="1,0,0,0" Padding="26,20,22,20" VerticalAlignment="Center">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="470">
     <StackPanel>
      <TextBlock x:Name="txtSectionTitle" Text="SCBL 登录" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,22"/>
      <TextBlock x:Name="txtUsernameLabel" Text="账号" FontSize="13" Foreground="#B6BEC3" Margin="0,0,0,4"/>
      <TextBox x:Name="txtUsername" Style="{StaticResource CinematicTextBox}" Margin="0,0,0,14"
       PreviewTextInput="UsernameTextBox_PreviewTextInput" DataObject.Pasting="UsernameTextBox_Pasting" TextChanged="UsernameTextBox_TextChanged" LostKeyboardFocus="RememberedIdentity_LostKeyboardFocus" AutomationProperties.Name="账号"/>
      <TextBlock x:Name="txtPasswordLabel" Text="密码" FontSize="13" Foreground="#B6BEC3" Margin="0,0,0,4"/>
      <PasswordBox x:Name="txtPassword" Style="{StaticResource CinematicPasswordBox}" Margin="0,0,0,18"
       PreviewTextInput="PasswordBox_PreviewTextInput" DataObject.Pasting="PasswordBox_Pasting" PasswordChanged="PasswordBox_PasswordChanged" AutomationProperties.Name="密码"/>
      <CheckBox x:Name="chkRememberPassword" Content="记住密码" IsChecked="True" Margin="0,-8,0,14" Checked="RememberPassword_Changed" Unchecked="RememberPassword_Changed" Style="{StaticResource CinematicCheckBox}" ToolTip="仅当前 Windows 用户可解密；取消将清除本机启动器保存的密码。"/>
      <Button x:Name="btnForgotPassword" Content="忘记密码" HorizontalAlignment="Right" Margin="0,-33,0,12" Style="{StaticResource CinematicLinkButton}" Click="ForgotPasswordButton_Click"/>
      <Grid Margin="0,0,0,4">
       <TextBlock x:Name="txtServerLabel" Text="服务器地址" FontSize="13" Foreground="#B6BEC3"/>
       <Button x:Name="bdDetectedHostName" HorizontalAlignment="Right" Visibility="Collapsed" Style="{StaticResource HostSwitchButton}" Click="DetectedHostName_Click">
        <AutomationProperties.Name><MultiBinding StringFormat="{}{0}{1}"><Binding ElementName="txtDetectedHostName" Path="Text"/><Binding ElementName="txtHostSwitchSuffix" Path="Text"/></MultiBinding></AutomationProperties.Name>
        <StackPanel Orientation="Horizontal"><TextBlock x:Name="txtDetectedHostName" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" MaxWidth="130" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="txtHostSwitchSuffix" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text=" 切换 ▾" FontSize="11"/></StackPanel>
       </Button>
      </Grid>
      <Grid Margin="0,0,0,16">
       <TextBox x:Name="txtServer" Style="{StaticResource CinematicTextBox}" PreviewTextInput="ServerTextBox_PreviewTextInput" DataObject.Pasting="ServerTextBox_Pasting" TextChanged="ServerTextBox_TextChanged" LostKeyboardFocus="RememberedIdentity_LostKeyboardFocus" AutomationProperties.Name="服务器地址"/>
       <TextBlock x:Name="txtServerPlaceholder" Text="房主 IP 或 IP:端口" Foreground="#788289" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <TextBlock x:Name="txtBindAdapterLabel" Text="联机网卡 / IPv4" FontSize="12" Foreground="#A5ADB2" Margin="0,0,0,6"/>
      <ComboBox x:Name="cmbBindAdapter" Height="34" SelectionChanged="BindAdapter_SelectionChanged" DropDownOpened="BindAdapter_DropDownOpened" AutomationProperties.Name="联机网卡"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#98050709" BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0"/>
  <StackPanel Grid.Row="2" Margin="36,0,0,0" VerticalAlignment="Center">
   <TextBlock x:Name="txtTopBadge" Text="1.0 · DX11 · LAN ONLY" FontSize="11" Foreground="#D8D8D8"/>
   <Button x:Name="btnPlayersSummary" Content="在线玩家 / 联机质量" HorizontalAlignment="Left" Style="{StaticResource CinematicLinkButton}" FontSize="11" Click="PlayersButton_Click"/>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,36,0">
   <Button x:Name="btnExportDiagnostics" Content="导出诊断包" Style="{StaticResource CinematicLinkButton}" FontSize="12" Click="ExportDiagnostics_Click" ToolTip="导出现存日志全文、字段脱敏持久配置及缺失清单；仍可能含敏感信息，历史有效配置快照尚未实施。不自动上传，不读取数据库或存档。包含网络地址与房间编号，请检查后再分享。"/>
   <Border Width="1" Height="16" Background="#55FFFFFF" Margin="16,0"/>
   <Button x:Name="btnCheckNetwork" Content="检测网络" Style="{StaticResource CinematicLinkButton}" FontSize="12" Click="CheckNetworkButton_Click"/>
  </StackPanel>
<Grid x:Name="toolsOverlay" Grid.RowSpan="3" Panel.ZIndex="95" Visibility="Collapsed" Background="#CC000000" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="ToolsOverlay_PreviewKeyDown">
 <Border Width="660" MaxHeight="530" Padding="28,22" Background="#F20B0F11" BorderBrush="#55FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <DockPanel Margin="0,0,0,16"><Button x:Name="btnToolsClose" DockPanel.Dock="Right" Content="×" Style="{StaticResource WindowChromeCloseButton}" Click="ToolsClose_Click"/><TextBlock x:Name="txtToolsTitle" Text="设置" FontSize="24" FontWeight="SemiBold"/></DockPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
     <Button x:Name="btnRecoveryPage" Content="忘记密码" Style="{StaticResource CinematicLinkButton}" Click="ForgotPasswordButton_Click" Margin="0,0,22,0"/>
     <Button x:Name="btnSavesPage" Content="恢复完整存档" Style="{StaticResource CinematicLinkButton}" Click="RestoreSavesButton_Click" Margin="0,0,22,0"/>
     <Button x:Name="btnPlayersPage" Content="在线玩家 / 联机质量" Style="{StaticResource CinematicLinkButton}" Click="PlayersButton_Click" Margin="0,0,22,0"/>
     <Button x:Name="btnAdvancedDiagnosticsPage" Content="高级诊断" Style="{StaticResource CinematicLinkButton}" Click="AdvancedDiagnosticsButton_Click"/>
    </StackPanel>
    <StackPanel x:Name="toolsHomePanel"><TextBlock x:Name="txtToolsIntro" Text="选择上方功能。存档按官方和 MOD 分开恢复；不会在正常启动时自动覆盖。" TextWrapping="Wrap" LineHeight="24"/></StackPanel>
    <StackPanel x:Name="recoveryPanel" Visibility="Collapsed">
     <TextBlock x:Name="txtRecoveryScope" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource ReadyAccentBrush}"/>
     <TextBlock x:Name="txtRecoveryHelp" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock x:Name="lblRecoveryCode" Text="注册时的恢复码"/><PasswordBox x:Name="recoveryCode" Style="{StaticResource CinematicPasswordBox}" MaxLength="512" Margin="0,0,0,12"/>
     <TextBlock x:Name="lblNewPassword" Text="新密码（至少一个字符）"/><PasswordBox x:Name="recoveryPassword" Style="{StaticResource CinematicPasswordBox}" MaxLength="1024" Margin="0,0,0,12"/>
     <TextBlock x:Name="lblConfirmPassword" Text="再次输入新密码"/><PasswordBox x:Name="recoveryConfirm" Style="{StaticResource CinematicPasswordBox}" MaxLength="1024" Margin="0,0,0,18"/>
     <Button x:Name="btnResetPassword" Content="重置密码" HorizontalAlignment="Right" Style="{StaticResource CinematicDialogAction}" Click="ResetPassword_Click"/>
     <TextBox x:Name="txtReplacementCode" IsReadOnly="True" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource CinematicTextBox}" Margin="0,15,0,0"/>
    </StackPanel>
    <StackPanel x:Name="savesPanel" Visibility="Collapsed">
     <TextBlock x:Name="txtSavesInfo" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,14"/>
     <TextBlock x:Name="txtSavePaths" TextWrapping="Wrap" FontSize="12" Foreground="#9CA8AD" Margin="0,0,0,20"/>
     <WrapPanel><Button x:Name="btnRestoreOfficial" Content="恢复官方存档" Style="{StaticResource CinematicLinkButton}" Margin="0,0,28,0" Click="RestoreOfficial_Click"/><Button x:Name="btnRestoreMod" Content="恢复 MOD 存档" Style="{StaticResource CinematicDialogAction}" Click="RestoreMod_Click"/></WrapPanel>
    </StackPanel>
    <StackPanel x:Name="playersPanel" Visibility="Collapsed">
     <TextBlock x:Name="txtPlayersHelp" TextWrapping="Wrap" LineHeight="21" FontSize="12" Margin="0,0,0,12"/>
     <TextBlock x:Name="txtQualityDetails" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{StaticResource ReadyAccentBrush}"/>
     <ScrollViewer Height="215" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="playersList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="4,8"><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#CDD3D6" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <Button x:Name="btnRefreshPlayers" Content="刷新" HorizontalAlignment="Right" Style="{StaticResource CinematicDialogAction}" Click="RefreshPlayers_Click" Margin="0,16,0,0"/>
    </StackPanel>
    <StackPanel x:Name="advancedDiagnosticsPanel" Visibility="Collapsed">
     <TextBlock x:Name="txtAdvancedDiagnosticsInfo" Text="仅按明确同意采集一次未处理异常；最小转储可能含敏感栈数据，不会自动上传，也不进入普通诊断包。" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,18" Foreground="{StaticResource TextSubBrush}"/>
     <WrapPanel>
      <Button x:Name="btnCaptureOnce" Content="诊断启动一次" Style="{StaticResource CinematicLinkButton}" Margin="0,0,28,0" Click="AdvancedCaptureOnce_Click"/>
      <Button x:Name="btnExportCapture" Content="导出异常现场" Style="{StaticResource CinematicLinkButton}" Click="AdvancedExportCapture_Click"/>
     </WrapPanel>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </Border>
</Grid>
<Grid x:Name="dialogOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed" Background="#B8000000" KeyboardNavigation.TabNavigation="Cycle">
 <Border x:Name="dialogCard" Width="520" Background="#F20B0F11" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="0" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
  <StackPanel>
   <TextBlock Text="SCBL LAN" FontSize="11" Foreground="{StaticResource ReadyAccentBrush}" Margin="0,0,0,12"/>
   <TextBlock x:Name="txtDialogTitle" Text="提示" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
   <Border Height="1" Background="#35FFFFFF" Margin="0,0,0,18"/>
   <ScrollViewer x:Name="dialogMessageScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,24" Padding="0,0,10,0">
    <StackPanel>
    <TextBlock x:Name="txtDialogMessage" Text="消息内容" Foreground="#B7C0C5" FontSize="13" LineHeight="23" TextWrapping="Wrap"/>
     <TextBox x:Name="txtDialogRecoveryCode" Visibility="Collapsed" IsReadOnly="True" IsReadOnlyCaretVisible="True" Style="{StaticResource CinematicTextBox}" FontFamily="Consolas" FontSize="16" Margin="0,12,0,0" AutomationProperties.Name="一次性恢复码"/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="btnDialogNo" Content="取消" Style="{StaticResource CinematicLinkButton}" MinWidth="72" Height="42" Click="DialogNoButton_Click" Margin="0,0,24,0"/>
    <Button x:Name="btnDialogYes" Content="确定" Style="{StaticResource CinematicDialogAction}" Click="DialogYesButton_Click"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Grid>

<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="guideOverlay" Grid.RowSpan="3" Panel.ZIndex="90" Visibility="Collapsed" Background="#66000000">
            <Border x:Name="guideHighlight" BorderBrush="#7DFFAE" BorderThickness="1" CornerRadius="0" Background="#18FFFFFF" IsHitTestVisible="False" />

            <TextBlock x:Name="guideArrow" Text="▲" Foreground="#7DFFAE" FontSize="18" FontWeight="Bold" Panel.ZIndex="91" IsHitTestVisible="False" />

            <Border x:Name="guideCard" Width="330" Background="#F20B0F11" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="0" Padding="14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="txtGuideStep" Text="1 / 6" Foreground="#7DFFAE" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock x:Name="txtGuideTitle" Text="指引标题" Foreground="{StaticResource TextMainBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10" />
                    <TextBlock x:Name="txtGuideMessage" Text="指引内容" Foreground="{StaticResource TextSubBrush}" FontSize="12.3" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnGuideSkip" Content="跳过" Width="62" Style="{StaticResource CinematicLinkButton}" Click="GuideSkipButton_Click" Margin="0,0,8,0" />
                        <Button x:Name="btnGuidePrev" Content="上一步" Width="72" Style="{StaticResource CinematicLinkButton}" Click="GuidePrevButton_Click" Margin="0,0,8,0" />
                        <Button x:Name="btnGuideNext" Content="下一步" Width="112" Style="{StaticResource CinematicDialogAction}" Click="GuideNextButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>

    
</Grid></Window>
