                                            <Setter TargetName="itemUnderline" Property="Background" Value="{StaticResource ReadyAccentBrush}" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemUnderline" Property="Background" Value="{StaticResource ReadyAccentBrush}" />
